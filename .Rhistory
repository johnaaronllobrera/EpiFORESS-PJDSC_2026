pmf <- pmf/sum(pmf)
delayed <- numeric(T); boundary_loss <- 0
for (t in which(out>0)) {
alloc <- as.vector(rmultinom(1, size=as.integer(round(out[t])), prob=pmf))
dest <- t + 0:(length(pmf)-1L)
ok <- dest <= T
if (any(ok)) delayed[dest[ok]] <- delayed[dest[ok]] + alloc[ok]
if (any(!ok)) boundary_loss <- boundary_loss + sum(alloc[!ok])
}
out <- delayed
add_event("reporting_delay",1,T,boundary_loss)
} else boundary_loss <- 0
if (art$fires["zero_reports"]) {
idx <- which(out>0)
if (length(idx)) {
chosen <- sample(idx, size=floor(length(idx)*art$zero_fraction))
if (length(chosen)) out[chosen] <- 0
}
}
if (art$fires["heaping"]) {
idx <- which(out >= 2*art$heaping_base)
if (length(idx)) {
chosen <- sample(idx, size=floor(length(idx)*art$heaping_fraction))
if (length(chosen)) out[chosen] <- round(out[chosen]/art$heaping_base)*art$heaping_base
}
}
if (art$fires["repetition"] && T>3) {
n <- max(1L, floor(T*runif(1,.02,.10)))
idx <- sort(sample(2:T,n))
for (i in idx) out[i] <- out[i-1L]
add_event("stale_value_repetition",min(idx),max(idx),length(idx)/T)
}
if (art$fires["missingness"]) {
frac <- art$missing_fraction
n <- max(1L,floor(T*frac))
idx <- sort(sample.int(T,n))
missing_code <- sample(c("NA","zero"),1)
out[idx] <- if (missing_code=="NA") NA_real_ else 0
# Record runs rather than every isolated week.
rr <- rle(diff(c(FALSE, seq_len(T)%in%idx, FALSE)))
add_event("missingness",min(idx),max(idx),frac)
}
list(y=out, events=if(length(events)) do.call(rbind,events) else
data.frame(Event_Type=character(),Start=integer(),End=integer(),Magnitude=numeric()),
boundary_loss=boundary_loss,
realized_missing_prop=mean(is.na(out)),
realized_zero_prop=mean(out==0,na.rm=TRUE),
realized_completeness=sum(out,na.rm=TRUE)/max(sum(y),1))
}
# ---------------------------------------------------------------------
# 7. CALIBRATION DIAGNOSTICS (NOT FORECASTING)
# ---------------------------------------------------------------------
series_summary <- function(y, week) {
ok <- is.finite(y)
z <- y[ok]
m <- if(length(z)) mean(z) else NA_real_
v <- if(length(z)>1) var(z) else NA_real_
ac <- NA_real_
if (sum(ok)>10) {
yy <- log1p(y)
pairs <- is.finite(yy[-1]) & is.finite(yy[-length(yy)])
if (sum(pairs)>5) ac <- suppressWarnings(cor(yy[-length(yy)][pairs], yy[-1][pairs]))
}
c(Mean=safe_mean(y), Variance=safe_var(y),
Zero_Proportion=if(length(z)) mean(z==0) else NA_real_,
Missing_Proportion=mean(!ok),
Dispersion_Index=if(is.finite(m)&&m>0&&is.finite(v)) v/m else NA_real_,
Lag1_ACF_Log=ac,
Seasonal_R2=tryCatch({
if(sum(ok)<30) NA_real_ else {
X <- cbind(1,fourier_basis(week,2))
fit <- lm.fit(X[ok,,drop=FALSE],log1p(y[ok]))
1-sum(fit$residuals^2)/max(sum((log1p(y[ok])-mean(log1p(y[ok])))^2),1e-10)
}
},error=function(e) NA_real_))
}
# ---------------------------------------------------------------------
# 8. MAIN SIMULATION
# ---------------------------------------------------------------------
dir.create(cfg$output_dir, recursive=TRUE, showWarnings=FALSE)
set.seed(cfg$seed)
start_time <- Sys.time()
say("Loading empirical seed")
seed_df <- load_seed(cfg)
disease_names <- sort(unique(seed_df$Disease))
grids <- setNames(lapply(disease_names, function(d) {
g <- prepare_grid(seed_df[seed_df$Disease==d,])
g$Disease <- d
g
}), disease_names)
if (!length(grids)) stop("No disease series found.")
say("Diseases found:", length(grids))
say("Calibrating disease-specific parameters")
params <- lapply(grids, fit_disease, cfg=cfg)
disease_parameters <- do.call(rbind,lapply(params, `[[`, "summary"))
rownames(disease_parameters) <- NULL
n_per <- ceiling(cfg$n_total/length(grids))
N <- n_per*length(grids)
T <- as.integer(cfg$series_length)
if (T < 104L) warning("Series shorter than 2 years; review whether this is appropriate.")
say("Generating",N,"series of",T,"weeks each")
result <- vector("list",N)
sid <- 0L
bases <- c(2,3,5,7,11,13)
for (d in seq_along(grids)) {
disease <- names(grids)[d]
p <- params[[d]]
# Low-discrepancy design gives coverage of simulation dials.
U <- sapply(seq_along(bases), function(k) halton(n_per+100L,bases[k])[(101L):(100L+n_per)])
U <- sweep(U,2,runif(ncol(U)),`+`) %% 1
colnames(U) <- c("level","amplitude","noise","persistence","trend","waves")
set.seed(cfg$seed + d*7919L)
for (j in seq_len(n_per)) {
sid <- sid+1L
set.seed(as.integer((cfg$seed + sid*104729L) %% .Machine$integer.max))
u <- U[j,]
dial <- list(
level=scale_u(u[1],cfg$design$level,TRUE),
seasonal_amplitude=scale_u(u[2],cfg$design$seasonal_amplitude,TRUE),
noise_multiplier=scale_u(u[3],cfg$design$noise_multiplier,TRUE),
persistence_shift=scale_u(u[4],cfg$design$persistence_shift,FALSE),
trend=scale_u(u[5],cfg$design$trend_multiplier,TRUE),
wave_rate_multiplier=scale_u(u[6],cfg$design$wave_rate_multiplier,TRUE)
)
art <- draw_artifacts(p,cfg)
outbreak_flag <- runif(1) < cfg$natural_outbreak_probability
latent <- simulate_latent(p,dial,T,cfg,outbreak=outbreak_flag)
observed <- apply_reporting(latent$y,latent$week,art,p,cfg)
all_events <- rbind(
if(nrow(latent$events)) transform(latent$events, Layer="latent") else NULL,
if(nrow(observed$events)) transform(observed$events, Layer="reporting") else NULL
)
if (is.null(all_events) || !nrow(all_events)) {
all_events <- data.frame(Event_Type=character(),Start=integer(),End=integer(),
Magnitude=numeric(),Layer=character())
}
fires <- art$fires
meta <- data.frame(
Series_ID=sid, Disease=disease, Replicate=j,
Random_Seed=as.integer((cfg$seed + sid*104729L) %% .Machine$integer.max),
Level_Mult=dial$level, Seasonal_Amplitude_Mult=dial$seasonal_amplitude,
Noise_Mult=dial$noise_multiplier, Persistence_Shift=dial$persistence_shift,
Trend_Mult=dial$trend, Wave_Rate_Mult=dial$wave_rate_multiplier,
NB_Theta=latent$theta, Persistence_Phi=latent$phi,
Trend_Slope_Per_Year=latent$trend_slope, N_Natural_Waves=latent$n_waves,
Quality_Factor=art$q, Quality_Artifact_Count=sum(fires[names(cfg$artifact_prob)]),
Simulated_Outbreak=outbreak_flag,
Assumed_Completeness=p$completeness,
Realized_Missing_Proportion=observed$realized_missing_prop,
Realized_Zero_Proportion=observed$realized_zero_prop,
Realized_Completeness_Ratio=observed$realized_completeness,
Delay_Boundary_Lost_Cases=observed$boundary_loss,
Mean_True_Cases=mean(latent$y), Mean_Observed_Cases=safe_mean(observed$y),
stringsAsFactors=FALSE
)
for (nm in names(fires)) meta[[paste0("Fired_",nm)]] <- as.logical(fires[[nm]])
meta$Artifact_Burden <- if (meta$Quality_Artifact_Count==0) "None" else
if (meta$Quality_Artifact_Count==1) "One" else
if (meta$Quality_Artifact_Count==2) "Two" else "Three_or_more"
result[[sid]] <- list(meta=meta, true=latent$y, mu=latent$mu,
observed=observed$y, events=all_events)
}
say("Completed disease",disease,"(",d,"/",length(grids),")")
}
say("Assembling output tables")
metadata <- do.call(rbind,lapply(result,`[[`,"meta"))
rownames(metadata) <- NULL
week <- rep(1:52,length.out=T)
series_data <- data.frame(
Series_ID=rep(metadata$Series_ID,each=T),
Disease=rep(metadata$Disease,each=T),
Time=rep(seq_len(T),times=N),
Week=rep(week,times=N),
Year_Index=rep(((seq_len(T)-1L)%/%52L)+1L,times=N),
Latent_Mean=as.numeric(unlist(lapply(result, function(x) x$mu),use.names=FALSE)),
True_Cases=as.integer(unlist(lapply(result, function(x) x$true),use.names=FALSE)),
Observed_Cases=as.numeric(unlist(lapply(result, function(x) x$observed),use.names=FALSE))
)
event_parts <- lapply(seq_along(result),function(i) {
ev <- result[[i]]$events
if (!nrow(ev)) return(NULL)
ev$Series_ID <- metadata$Series_ID[i]
ev$Disease <- metadata$Disease[i]
ev
})
event_log <- do.call(rbind,event_parts)
if (is.null(event_log)) event_log <- data.frame()
# Compare empirical seed summaries with simulated distributions.
say("Building calibration diagnostics")
calibration_diagnostics <- list()
for (d in names(grids)) {
g <- grids[[d]]
emp <- series_summary(g$Cases,g$Week)
sims <- which(metadata$Disease==d)
ns <- min(cfg$n_calibration_replicates,length(sims))
set.seed(cfg$seed+555L+match(d,names(grids)))
chosen <- sample(sims,ns)
sm <- t(vapply(chosen,function(i) {
yy <- result[[i]]$observed
series_summary(yy,week)
},numeric(length(emp))))
colnames(sm) <- names(emp)
for (nm in names(emp)) {
q <- quantile(sm[,nm],c(.025,.5,.975),na.rm=TRUE,names=FALSE)
calibration_diagnostics[[length(calibration_diagnostics)+1L]] <- data.frame(
Disease=d,Metric=nm,Empirical_Value=unname(emp[nm]),
Simulated_Q025=q[1],Simulated_Median=q[2],Simulated_Q975=q[3],
Empirical_Inside_Simulated_95=if(is.finite(emp[nm])&&all(is.finite(q)))
emp[nm]>=q[1]&&emp[nm]<=q[3] else NA,
N_Simulated=ns,stringsAsFactors=FALSE)
}
}
calibration_diagnostics <- do.call(rbind,calibration_diagnostics)
rownames(calibration_diagnostics) <- NULL
artifact_names <- names(cfg$artifact_prob)
artifact_realization <- data.frame(
Artifact=artifact_names,
Configured_Probability=as.numeric(cfg$artifact_prob),
Realized_Probability=vapply(artifact_names,function(nm)
mean(metadata[[paste0("Fired_",nm)]],na.rm=TRUE),numeric(1)),
stringsAsFactors=FALSE
)
burden_summary <- as.data.frame(table(metadata$Disease,metadata$Artifact_Burden),
stringsAsFactors=FALSE)
names(burden_summary) <- c("Disease","Artifact_Burden","N_Series")
burden_summary$Proportion <- ave(burden_summary$N_Series,burden_summary$Disease,
FUN=function(x)x/sum(x))
# ---------------------------------------------------------------------
# 9. REPORT AND SAVE
# ---------------------------------------------------------------------
cat("\n================ EpiFORESS SIMULATION REPORT ================\n")
cat("Script role: simulation only; no forecasting experiment or labels.\n")
cat("Diseases:",length(grids)," | Series:",N," | Weeks/series:",T,
" | Long rows:",nrow(series_data),"\n")
cat("\nCalibration model status:\n")
print(table(disease_parameters$Fit_Status))
cat("\nConfigured versus realized artifact prevalence:\n")
print(transform(artifact_realization,
Configured_Probability=round(Configured_Probability,3),
Realized_Probability=round(Realized_Probability,3)))
cat("\nEmpirical calibration diagnostic coverage by metric:\n")
print(round(tapply(calibration_diagnostics$Empirical_Inside_Simulated_95,
calibration_diagnostics$Metric,mean,na.rm=TRUE),3))
cat("\nArtifact burden:\n")
print(burden_summary)
cat("\nReminder: diagnostics are descriptive, not proof of realism.\n")
save_table <- function(x,name) {
saveRDS(x,file.path(cfg$output_dir,paste0(name,".rds")))
if (has_pkg("arrow")) arrow::write_parquet(x,file.path(cfg$output_dir,paste0(name,".parquet")))
if (has_pkg("data.table")) data.table::fwrite(x,file.path(cfg$output_dir,paste0(name,".csv.gz")))
}
say("Saving outputs")
save_table(series_data,"series_data")
save_table(metadata,"series_metadata")
save_table(event_log,"event_log")
write.csv(disease_parameters,file.path(cfg$output_dir,"disease_parameters.csv"),row.names=FALSE)
write.csv(calibration_diagnostics,file.path(cfg$output_dir,"calibration_diagnostics.csv"),row.names=FALSE)
write.csv(artifact_realization,file.path(cfg$output_dir,"artifact_realization.csv"),row.names=FALSE)
write.csv(burden_summary,file.path(cfg$output_dir,"artifact_burden_summary.csv"),row.names=FALSE)
saveRDS(list(config=cfg,parameters=params,session=sessionInfo(),
notes=c(
"Simulation only: forecasting is deliberately excluded.",
"Artifact priors are assumptions unless externally calibrated.",
"Week 53 is mapped to week 52 and aggregated.",
"True_Cases is latent incidence; Observed_Cases is surveillance output."
)),file.path(cfg$output_dir,"simulation_settings.rds"))
if (has_pkg("openxlsx")) {
wb <- openxlsx::createWorkbook()
tabs <- list(disease_parameters=disease_parameters,
calibration_diagnostics=calibration_diagnostics,
artifact_realization=artifact_realization,
artifact_burden_summary=burden_summary)
for (nm in names(tabs)) {
openxlsx::addWorksheet(wb,nm)
openxlsx::writeData(wb,nm,tabs[[nm]])
}
openxlsx::saveWorkbook(wb,file.path(cfg$output_dir,"simulation_summary.xlsx"),overwrite=TRUE)
}
say("Finished in",round(as.numeric(difftime(Sys.time(),start_time,units="mins")),1),
"minutes. Outputs:",cfg$output_dir)
library(readxl)
library(dplyr)
library(stringr)
library(writexl)
file_path <- paste0(
"C:/The Probable Trajectory/GLIFONEA ET AL. (2026)/",
"RESEARCH-DATA (1) (1).xlsx"
)
output_path <- paste0(
"C:/The Probable Trajectory/GLIFONEA ET AL. (2026)/",
"cleaned_survey_and_audit.xlsx"
)
# 1. Import the original workbook
raw <- read_excel(file_path, sheet = 1)
# 2. Display every original column name and position
column_map <- data.frame(
position = seq_along(names(raw)),
original_name = names(raw)
)
print(column_map, row.names = FALSE)
# Expected 47-column structure
if (ncol(raw) != 47) {
stop(
"Expected 47 columns but found ", ncol(raw),
". Inspect column_map before proceeding."
)
}
# 3. Define mapping based on the observed workbook structure
mapping <- data.frame(
new_name = c(
"respondent_id",
"parent_age",
"parent_sex",
"education",
"household_income",
"child_age_group",
"child_sex",
sprintf("pp%02d", 1:20),
sprintf("dr%02d", 1:15)
),
position = c(
1, 3:8,
10:29,
32:46
)
)
mapping$original_name <- names(raw)[mapping$position]
cat("\n--- PROPOSED COLUMN MAPPING ---\n")
print(mapping, row.names = FALSE)
# Export mapping for documentation
write_xlsx(
list(column_mapping = mapping),
file.path(dirname(file_path), "column_mapping.xlsx")
)
# 4. Create a clean analysis dataset using mapped columns
dat <- as.data.frame(raw)
names(dat)[mapping$position] <- mapping$new_name
dat <- dat[, mapping$new_name, drop = FALSE]
# Preserve original imported data in memory as `raw`.
# All transformations below apply only to `dat`.
# 5. Standardize text responses
clean_text <- function(x) {
x <- str_squish(as.character(x))
x <- str_to_lower(x)
x[x %in% c("", "na", "n/a")] <- NA_character_
x
}
text_vars <- c(
"parent_sex", "education", "household_income",
"child_age_group", "child_sex",
sprintf("pp%02d", 1:20),
sprintf("dr%02d", 1:15)
)
dat <- dat %>%
mutate(across(all_of(text_vars), clean_text))
# 6. Clean demographic categories
dat <- dat %>%
mutate(
parent_age = suppressWarnings(
as.numeric(as.character(parent_age))
),
parent_sex = case_when(
parent_sex %in% c("f", "female", "babae") ~ "Female",
parent_sex %in% c("m", "male", "lalaki") ~ "Male",
TRUE ~ NA_character_
),
child_sex = case_when(
child_sex %in% c("f", "female", "babae") ~ "Female",
child_sex %in% c("m", "male", "lalaki") ~ "Male",
TRUE ~ NA_character_
),
child_age_group = case_when(
str_detect(child_age_group, "^6\\s*[-–]\\s*8") ~
"6-8 years old",
str_detect(child_age_group, "^9\\s*[-–]\\s*10") ~
"9-10 years old",
TRUE ~ NA_character_
),
education = case_when(
education == "elementary" ~ "Elementary",
education == "high school" ~ "High School",
education %in% c(
"vocational", "vocational/technical", "technical"
) ~ "Vocational/Technical",
education %in% c("college", "college graduate") ~
"College/College Graduate",
education == "postgraduate" ~ "Postgraduate",
TRUE ~ NA_character_
),
household_income = case_when(
household_income == "below poverty line" ~
"Below poverty line",
household_income == "low income" ~ "Low income",
household_income == "lower middle income" ~
"Lower middle income",
household_income == "middle income" ~ "Middle income",
household_income == "upper middle income" ~
"Upper middle income",
household_income == "upper income" ~ "Upper income",
TRUE ~ NA_character_
)
)
# 7. Recode response labels while preserving missing values
recode_likert <- function(x, response_map) {
# Accept either original text labels or already numeric codes
numeric_x <- suppressWarnings(as.numeric(x))
result <- unname(response_map[x])
already_numeric <- !is.na(numeric_x) &
numeric_x %in% 1:4
result[already_numeric] <- numeric_x[already_numeric]
as.numeric(result)
}
practice_map <- c(
"never" = 1,
"sometimes" = 2,
"often" = 3,
"always" = 4,
"hindi kailanman" = 1,
"paminsan-minsan" = 2,
"madalas" = 3,
"palagi" = 4
)
diet_map <- c(
"never" = 1,
"1-2 times/week" = 2,
"1–2 times/week" = 2,
"1- 2 times/week" = 2,
"3-4 times/week" = 3,
"3–4 times/week" = 3,
"3- 4 times/week" = 3,
"daily" = 4,
"hindi kailanman" = 1,
"1-2 beses kada linggo" = 2,
"3-4 beses kada linggo" = 3,
"araw-araw" = 4
)
pp_vars <- sprintf("pp%02d", 1:20)
dr_vars <- sprintf("dr%02d", 1:15)
dat[pp_vars] <- lapply(
dat[pp_vars], recode_likert,
response_map = practice_map
)
dat[dr_vars] <- lapply(
dat[dr_vars], recode_likert,
response_map = diet_map
)
# 8. Generate data-quality reports
all_items <- c(pp_vars, dr_vars)
missing_report <- data.frame(
variable = names(dat),
missing_n = vapply(dat, function(x) sum(is.na(x)), integer(1)),
missing_percent = round(
vapply(dat, function(x) mean(is.na(x)) * 100, numeric(1)),
2
)
)
invalid_responses <- do.call(
rbind,
lapply(all_items, function(v) {
idx <- which(
!is.na(dat[[v]]) & !(dat[[v]] %in% 1:4)
)
data.frame(
row = idx,
variable = v,
value = as.character(dat[[v]][idx])
)
})
)
