/* ============================================================
   PANEL HEADING ROW (heading + inline action button, e.g. export)
   ============================================================ */
.panel-heading-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12px;
