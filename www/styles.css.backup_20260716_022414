  font-size: 0.88rem;
  font-weight: 700;
  white-space: nowrap;
}
@media (max-width: 560px) {
  .panel-heading-row {
    flex-direction: column;
    align-items: flex-start;
  }
  .export-btn {
    width: 100%;
    justify-content: center;
  }
}

/* ============================================================
   EXPORT BUTTON GROUP (Extracted Features tab: per-series + batch)
   ============================================================ */
.export-btn-group {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}
.export-btn-secondary,
.btn-secondary.export-btn {
  background: #ffffff !important;
  color: var(--ep-primary) !important;
  border: 1px solid var(--ep-primary) !important;
}
.export-btn-secondary:hover,
.btn-secondary.export-btn:hover,
.export-btn-secondary:focus,
.btn-secondary.export-btn:focus {
  background: var(--ep-gold-soft) !important;
  border-color: var(--ep-gold) !important;
  color: var(--ep-gold-dark) !important;
}
@media (max-width: 700px) {
  .export-btn-group {
    width: 100%;
    flex-direction: column;
  }
  .export-btn-group .export-btn {
    width: 100%;
    justify-content: center;
  }
}

/* ============================================================
   EXPORT BUTTONS — full visual refresh (icon, radius, lift,
   consistent sizing between primary/secondary/hero variants)
   ============================================================ */
.export-btn {
  display: inline-flex !important;
  align-items: center;
  gap: 0.5rem;
  padding: 0.6rem 1.1rem !important;
  border-radius: 12px !important;
  font-size: 0.85rem !important;
  font-weight: 700 !important;
  letter-spacing: 0.005em;
  line-height: 1.1;
  white-space: nowrap;
  box-shadow: 0 6px 16px rgba(29, 78, 158, 0.16);
  transition: transform 130ms ease, box-shadow 130ms ease,
    background-color 130ms ease, color 130ms ease, border-color 130ms ease;
}
.export-btn:hover,
.export-btn:focus {
  transform: translateY(-1px);
}
.export-btn:active {
  transform: translateY(0);
}
.export-btn .ef-btn-icon {
  width: 16px;
  height: 16px;
  flex: 0 0 16px;
}
.btn-primary.export-btn {
  background: var(--ep-primary) !important;
  border: 1px solid var(--ep-primary) !important;
  color: #ffffff !important;
}
.btn-primary.export-btn:hover,
.btn-primary.export-btn:focus {
  background: #173F7E !important;
  border-color: #173F7E !important;
  box-shadow: 0 10px 22px rgba(29, 78, 158, 0.26);
}
.export-btn-secondary,
.btn-secondary.export-btn {
  background: #ffffff !important;
  color: var(--ep-primary) !important;
  border: 1px solid #C4D3E8 !important;
  box-shadow: 0 4px 12px rgba(29, 78, 158, 0.08);
}
.export-btn-secondary:hover,
.btn-secondary.export-btn:hover,
.export-btn-secondary:focus,
.btn-secondary.export-btn:focus {
  background: var(--ep-gold-soft) !important;
  border-color: var(--ep-gold) !important;
  color: var(--ep-gold-dark) !important;
}

/* Hero variant: the full PDF report button gets a bit more
   visual weight since it is the most valuable export. */
.export-btn-hero {
  padding: 0.72rem 1.3rem !important;
  font-size: 0.9rem !important;
  border-radius: 14px !important;
  background: linear-gradient(135deg, var(--ep-primary) 0%, #16336B 100%) !important;
  border: 1px solid #16336B !important;
  box-shadow: 0 10px 24px rgba(18, 39, 92, 0.24);
}
.export-btn-hero:hover,
.export-btn-hero:focus {
  box-shadow: 0 14px 30px rgba(18, 39, 92, 0.32);
}
.export-btn-hero .ef-btn-icon {
  width: 18px;
  height: 18px;
  flex: 0 0 18px;
}

/* Section title paired with an action button (Overview tab) */
.section-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 14px;
}
.section-title-row .section-title {
  margin: 0;
}

@media (max-width: 700px) {
  .section-title-row {
    flex-direction: column;
    align-items: flex-start;
  }
  .export-btn-hero {
    width: 100%;
    justify-content: center;
  }
}

/* ============================================================
   FLAT BUTTON OVERRIDE
   No shadows, no hover-lift, no gradients — solid flat fills
   with a simple color change on hover/focus. Overrides the
   earlier "floating" export button treatment.
   ============================================================ */
.export-btn,
.btn-primary.export-btn,
.btn-secondary.export-btn,
.export-btn-secondary,
.export-btn-hero {
  box-shadow: none !important;
  transform: none !important;
  background-image: none !important;
  transition: background-color 120ms ease, border-color 120ms ease, color 120ms ease !important;
}
.export-btn:hover,
.export-btn:focus,
.export-btn:active,
.export-btn-hero:hover,
.export-btn-hero:focus,
.export-btn-hero:active {
  transform: none !important;
  box-shadow: none !important;
}
.btn-primary.export-btn,
.export-btn-hero {
  background: var(--ep-primary) !important;
  border: 1px solid var(--ep-primary) !important;
  color: #ffffff !important;
}
.btn-primary.export-btn:hover,
.btn-primary.export-btn:focus,
.export-btn-hero:hover,
.export-btn-hero:focus {
  background: #173F7E !important;
  border-color: #173F7E !important;
}
.export-btn-secondary,
.btn-secondary.export-btn {
  background: #EFF3FC !important;
  border: 1px solid #C4D3E8 !important;
  color: var(--ep-primary) !important;
}
.export-btn-secondary:hover,
.btn-secondary.export-btn:hover,
.export-btn-secondary:focus,
.btn-secondary.export-btn:focus {
  background: var(--ep-gold-soft) !important;
  border-color: var(--ep-gold) !important;
  color: var(--ep-gold-dark) !important;
}

