:root {
      --ep-bg:#F7F9FE;
      --ep-card:#FFFFFF;
      --ep-soft:#E9F0FB;
      --ep-soft-2:#EFF3FC;
      --ep-text:#17263A;
      --ep-muted:#5A6B85;
      --ep-heading:#12275C;
      --ep-primary:#1D4E9E;
      --ep-primary-dark:#143A6B;
      --ep-border:rgba(29,78,158,0.16);
      --ep-border-2:rgba(18,39,92,0.14);
      --ep-shadow:0 8px 26px rgba(16,42,51,0.065);
    }
    html, body {
      min-height:100%;
      background:
        radial-gradient(circle at top left, rgba(29,78,158,0.07), transparent 32%),
        linear-gradient(180deg, #F7F9FE 0%, #ECF1FB 100%);
      color:var(--ep-text);
      font-family:'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      font-size:0.94rem;
      overflow-x:hidden;
    }
    .navbar {
      background:rgba(255,255,255,0.94)!important;
      border-bottom:1px solid var(--ep-border);
      box-shadow:0 2px 12px rgba(16,42,51,0.045);
      backdrop-filter:blur(16px);
    }
    .navbar-brand {
      color:var(--ep-heading)!important;
      font-weight:900!important;
      letter-spacing:-0.055em;
    }
    .navbar-nav .nav-link {
      color:var(--ep-muted)!important;
      font-weight:750;
    }
    .navbar-nav .nav-link.active {
      color:var(--ep-primary)!important;
    }
    .container-fluid {
      max-width:1680px;
      padding-left:22px;
      padding-right:22px;
    }
    .hero {
      background:rgba(255,255,255,0.94);
      border:1px solid var(--ep-border);
      border-radius:28px;
      padding:34px 38px;
      margin:20px 0 18px 0;
      box-shadow:var(--ep-shadow);
    }
    .hero h1 {
      color:var(--ep-heading);
      font-size:clamp(42px,5.6vw,76px);
      font-weight:950;
      letter-spacing:-0.085em;
      line-height:0.92;
      margin:0 0 10px 0;
    }
    .hero h3 {
      color:var(--ep-primary);
      font-size:clamp(18px,2vw,27px);
      font-weight:800;
      letter-spacing:-0.045em;
      margin:0 0 10px 0;
    }
    .hero p {
      color:var(--ep-muted);
      max-width:1100px;
      line-height:1.48;
      margin:0;
    }
    .app-card {
      background:rgba(255,255,255,0.96);
      border:1px solid var(--ep-border);
      border-radius:24px;
      padding:22px;
      box-shadow:var(--ep-shadow);
      margin-bottom:16px;
    }
    .app-card h3, .app-card h4 {
      color:var(--ep-heading);
      font-weight:850;
      letter-spacing:-0.045em;
      margin-bottom:12px;
    }
    .purpose-card p, .purpose-card li {
      line-height:1.52;
      color:var(--ep-text);
    }
    .purpose-card li {
      margin-bottom:7px;
    }
    .sidebar-card {
      position:sticky;
      top:82px;
    }
    label {
      color:var(--ep-heading);
      font-weight:720;
      margin-bottom:5px;
    }
    .form-control, .selectize-input {
      background:#FFFFFF!important;
      border:1px solid var(--ep-border-2)!important;
      border-radius:13px!important;
      min-height:40px;
      box-shadow:none!important;
      color:var(--ep-text)!important;
      font-size:0.92rem;
    }
    .form-control:focus, .selectize-input.focus {
      border-color:var(--ep-primary)!important;
      box-shadow:0 0 0 3px rgba(8,126,139,0.13)!important;
    }
    .shiny-input-container {
      width:100%!important;
      max-width:100%!important;
      margin-bottom:12px;
    }
    .btn-primary {
      background:var(--ep-primary);
      border:none;
      border-radius:14px;
      padding:10px 18px;
      font-weight:800;
      width:100%;
      box-shadow:none;
    }
    .btn-primary:hover, .btn-primary:focus {
      background:var(--ep-primary-dark);
      border:none;
      box-shadow:none;
    }
    .sample-data-row {
      display:flex;
      flex-direction:column;
      align-items:flex-start;
      gap:6px;
      margin:2px 0 14px 0;
    }
    .btn-sample-data {
      background:#FFFFFF;
      border:1.5px dashed var(--ep-primary);
      color:var(--ep-primary-dark);
      border-radius:13px;
      padding:9px 16px;
      font-weight:800;
      font-size:0.88rem;
      width:100%;
      box-shadow:none;
    }
    .btn-sample-data:hover, .btn-sample-data:focus {
      background:var(--ep-soft);
      border-color:var(--ep-primary-dark);
      color:var(--ep-primary-dark);
      box-shadow:none;
    }
    .small-note, .plot-source {
      color:var(--ep-muted);
      font-size:0.87rem;
      line-height:1.38;
    }
    .results-shell {
      margin-top:20px;
    }
    .card {
      border:1px solid var(--ep-border)!important;
      border-radius:24px!important;
      box-shadow:var(--ep-shadow)!important;
      overflow:hidden!important;
      background:#FFFFFF!important;
    }
    .card-header {
      background:#FFFFFF!important;
      border-bottom:1px solid var(--ep-border)!important;
      color:var(--ep-heading)!important;
      font-weight:850;
    }
    .nav-tabs {
      border-bottom:1px solid var(--ep-border);
      gap:3px;
      padding-left:8px;
      padding-right:8px;
      padding-top:5px;
      flex-wrap:wrap;
    }
    .nav-tabs .nav-link {
      border:none!important;
      color:var(--ep-muted);
      font-weight:780;
      padding:10px 12px;
      font-size:0.91rem;
      border-radius:12px 12px 0 0;
    }
    .nav-tabs .nav-link.active {
      color:var(--ep-primary-dark)!important;
      background:var(--ep-soft)!important;
      border-bottom:2px solid var(--ep-primary)!important;
    }
    .tab-pane {
      padding-top:4px;
    }
    .tab-section {
      padding:10px 2px 2px 2px;
    }
    .section-title {
      color:var(--ep-heading);
      font-size:1.35rem;
      font-weight:900;
      letter-spacing:-0.05em;
      margin-bottom:4px;
    }
    .section-subtitle {
      color:var(--ep-muted);
      margin-bottom:16px;
      line-height:1.4;
      max-width:980px;
    }
    .overview-grid {
      display:grid;
      grid-template-columns:minmax(280px, 0.95fr) minmax(320px, 1.35fr);
      gap:16px;
      align-items:stretch;
    }
    
.score-hero-minimal {
  min-height: 320px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
}
.score-hero-minimal .score-number {
  margin: 0;
}
.metric-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
  align-items: stretch;
}
.metric-card-wide {
  grid-column: 1 / -1;
  min-height: 160px;
}
.metric-card .metric-value {
  word-break: break-word;
}
@media (max-width: 992px) {
  .metric-grid {
    grid-template-columns: 1fr;
  }
  
  .metric-card-wide {
    grid-column: auto;
  }
}
    .score-hero {
      background:linear-gradient(135deg, #FFFFFF 0%, #E9F0FB 100%);
      border:1px solid var(--ep-border);
      border-radius:24px;
      padding:28px 24px;
      min-height:320px;
      display:flex;
      flex-direction:column;
      justify-content:center;
      align-items:center;
      text-align:center;
    }
    .score-number {
      font-size:clamp(82px,11vw,150px);
      font-weight:950;
      line-height:0.85;
      color:var(--ep-heading);
      letter-spacing:-0.09em;
    }
    .score-caption {
      color:var(--ep-muted);
      font-weight:800;
      margin-top:16px;
      font-size:1.02rem;
    }
    .badge-row {
      display:flex;
      justify-content:center;
      align-items:center;
      gap:8px;
      flex-wrap:wrap;
      margin-top:16px;
    }
    .badge-custom {
      display:inline-block;
      color:var(--ep-primary-dark);
      background:#FFFFFF;
      border:1.5px solid var(--ep-primary);
      padding:8px 13px;
      border-radius:999px;
      font-weight:850;
      font-size:0.9rem;
      line-height:1.2;
    }
    .metric-grid {
      display:grid;
      grid-template-columns:repeat(2,minmax(0,1fr));
      gap:14px;
    }
    .metric-card {
      background:#FFFFFF;
      border:1px solid var(--ep-border);
      border-radius:20px;
      padding:18px 18px;
      min-height:135px;
      box-shadow:0 4px 14px rgba(16,42,51,0.045);
    }
    .metric-label {
      color:var(--ep-muted);
      font-size:0.82rem;
      font-weight:800;
      text-transform:uppercase;
      letter-spacing:0.04em;
      margin-bottom:8px;
    }
    .metric-value {
      color:var(--ep-heading);
      font-size:1.35rem;
      font-weight:900;
      letter-spacing:-0.045em;
      line-height:1.12;
    }
    .metric-note {
      color:var(--ep-muted);
      font-size:0.86rem;
      line-height:1.35;
      margin-top:7px;
    }
    .clean-panel {
      background:#FFFFFF;
      border:1px solid var(--ep-border);
      border-radius:22px;
      padding:20px 22px;
      box-shadow:0 4px 14px rgba(16,42,51,0.045);
      margin-bottom:16px;
    }
    .clean-panel h4 {
      color:var(--ep-heading);
      font-weight:900;
      letter-spacing:-0.045em;
      margin-bottom:8px;
    }
    
    .clean-file-input .shiny-input-container {
  margin-bottom: 14px;
}
.clean-file-input label.control-label {
  color: var(--ep-heading);
  font-weight: 800;
  letter-spacing: -0.02em;
  margin-bottom: 8px;
}
.clean-file-input .input-group {
  background: #FFFFFF;
  border: 1px solid var(--ep-border);
  border-radius: 18px;
  padding: 6px;
  min-height: 58px;
  box-shadow: 0 4px 14px rgba(16,42,51,0.045);
  overflow: hidden;
}
.clean-file-input .btn-file,
.clean-file-input .btn-default,
.clean-file-input .input-group-btn .btn,
.clean-file-input .input-group-prepend .btn {
  background: var(--ep-primary) !important;
  color: #FFFFFF !important;
  border: none !important;
  border-radius: 13px !important;
  padding: 11px 18px !important;
  font-weight: 850 !important;
  box-shadow: none !important;
  min-height: 44px;
}
.clean-file-input .btn-file:hover,
.clean-file-input .btn-default:hover,
.clean-file-input .input-group-btn .btn:hover,
.clean-file-input .input-group-prepend .btn:hover {
  background: var(--ep-primary-dark) !important;
  color: #FFFFFF !important;
}
.clean-file-input input.form-control[readonly],
.clean-file-input .form-control {
  border: none !important;
  background: transparent !important;
  box-shadow: none !important;
  color: var(--ep-heading) !important;
  font-weight: 650;
  padding-left: 14px !important;
  min-height: 44px;
}
.clean-file-input .form-control::placeholder {
  color: var(--ep-muted);
  font-weight: 500;
}
.clean-file-input .progress {
  height: 6px;
  border-radius: 999px;
  margin-top: 8px;
  background: var(--ep-soft);
  overflow: hidden;
}
.clean-file-input .progress-bar {
  background-color: var(--ep-primary);
}
    .interpretation-box {
      background:var(--ep-soft-2);
      border:1px solid var(--ep-border);
      border-radius:20px;
      padding:18px 20px;
      line-height:1.48;
      color:var(--ep-text);
    }
    .driver-grid {
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:16px;
    }
    .driver-grid.driver-grid-single {
      grid-template-columns:1fr;
    }
    .driver-card {
      background:#FFFFFF;
      border:1px solid var(--ep-border);
