/* ============================================================
   INSTAT-INSPIRED ACCENT: BLUE + GOLD, USED CONSISTENTLY
   The primary brand color stays blue; gold is a deliberate,
   restrained second accent so it reads as a considered palette
   rather than a rainbow. It shows up in a handful of fixed,
   repeatable spots so it is visible on every page:
     1) a thin gold rule along the very top of the navbar
     2) a blue-to-gold tick mark beside every section title
     3) a matching flourish under the hero title
     4) the score-readiness threshold marker (the "target line")
     5) a soft gold focus/hover glow on primary buttons
     6) the current-page pill in table pagination
   ============================================================ */
:root {
  --ep-gold: #C99A2E;
  --ep-gold-dark: #9C7818;
  --ep-gold-soft: #FBF1D9;
}

.navbar {
  border-top: 3px solid var(--ep-gold);
}

.section-title {
  position: relative;
  padding-left: 20px;
}
.section-title::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0.12em;
  bottom: 0.12em;
  width: 5px;
  border-radius: 4px;
  background: linear-gradient(180deg, var(--ep-primary) 0%, var(--ep-gold) 100%);
}

.hero {
  text-align: left;
}
.hero h1 {
  position: relative;
  display: inline-block;
  padding-bottom: 16px;
}
.hero h1::after {
  content: "";
  position: absolute;
  left: 2px;
  bottom: 0;
  width: 92px;
  height: 4px;
  border-radius: 3px;
  background: linear-gradient(90deg, var(--ep-primary) 0%, var(--ep-gold) 100%);
}

.ef-threshold-marker {
  background: var(--ep-gold-dark) !important;
  box-shadow: 0 0 0 3px rgba(201, 154, 46, 0.22);
}

.btn-primary {
  border-color: var(--ep-primary) !important;
}
.btn-primary:hover,
.btn-primary:focus {
  border-color: var(--ep-gold) !important;
  box-shadow: 0 0 0 3px rgba(201, 154, 46, 0.32) !important;
}

/* DataTables pagination: keep the current-page pill blue (as-is),
   but give hover states and the surrounding wrapper a gold whisper
   so the pairing shows up on every table, on every tab. */
.dataTables_wrapper .dataTables_paginate .paginate_button.current,
.dataTables_wrapper .dataTables_paginate .paginate_button.current:hover {
  background: var(--ep-primary) !important;
  border-color: var(--ep-primary) !important;
  color: #ffffff !important;
}
.dataTables_wrapper .dataTables_paginate .paginate_button:hover:not(.current) {
  background: var(--ep-gold-soft) !important;
  border-color: var(--ep-gold) !important;
  color: var(--ep-gold-dark) !important;
}

/* Card headings get a small gold underline tick, echoed everywhere
   clean-panel / app-card / plot-card headings appear. */
.app-card > h3:first-of-type,
.clean-panel > h4:first-of-type,
.plot-card-heading h4 {
  position: relative;
  display: inline-block;
  padding-bottom: 8px;
}
.app-card > h3:first-of-type::after,
.clean-panel > h4:first-of-type::after,
.plot-card-heading h4::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: 0;
  width: 46px;
  height: 3px;
  border-radius: 2px;
  background: linear-gradient(90deg, var(--ep-primary) 0%, var(--ep-gold) 100%);
}

.guide-stat-value {
  color: var(--ep-gold-dark) !important;
}

@media (max-width: 700px) {
  .hero h1::after {
    width: 66px;
  }
}

/* ============================================================
   SELECT ALL / CLEAR LINKS (sheet and series selectors)
   ============================================================ */
.select-all-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
  margin: -6px 0 14px 2px;
}
.select-all-row a.action-button,
.select-all-row a.action-button:visited {
  padding: 0;
  border: none;
  background: none;
  color: var(--ep-primary);
  font-size: 0.82rem;
  font-weight: 700;
  text-decoration: none;
}
.select-all-row a.action-button:hover,
.select-all-row a.action-button:focus {
  color: var(--ep-gold-dark);
  text-decoration: underline;
}
.select-all-sep {
  color: var(--ep-border-2);
  font-size: 0.82rem;
}
.select-all-note {
  color: var(--ep-muted);
