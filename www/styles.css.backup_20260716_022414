/* ============================================================
   EXPLAINABLE OVERVIEW UI (score hero, evidence meters,
   attribution cards) — polished-explainable-ui-2026-07-10
   Sizing tuned larger/roomier than a typical dashboard on
   purpose: this section carries the most important reading
   in the app, so legibility wins over density.
   ============================================================ */

.ef-navbar-brand {
  display: flex;
  align-items: center;
  gap: 0.68rem;
  min-width: 240px;
}
.ef-navbar-logo,
.ef-navbar-monogram {
  width: 36px;
  height: 36px;
  border-radius: 10px;
  flex: 0 0 36px;
}
.ef-navbar-logo { object-fit: contain; }
.ef-navbar-monogram {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: linear-gradient(145deg, #1D4E9E, #12275C);
  font-size: 1.05rem;
  font-weight: 800;
  box-shadow: 0 6px 16px rgba(8, 126, 139, 0.22);
}
.ef-navbar-brand-copy { display: flex; flex-direction: column; line-height: 1.05; }
.ef-navbar-brand-name { color: #102A33; font-weight: 800; letter-spacing: -0.02em; }
.ef-navbar-brand-subtitle { color: #66808A; font-size: 0.72rem; font-weight: 600; margin-top: 0.25rem; }

.ef-overview-layout {
  display: grid;
  grid-template-columns: minmax(300px, 0.82fr) minmax(520px, 1.7fr);
  gap: 18px;
  align-items: stretch;
  margin: 18px 0;
}

/* --- Score hero card --- */
.ef-score-card {
  --ef-accent: #1D4E9E;
  position: relative;
  min-height: 330px;
  padding: 27px;
  border: 1px solid rgba(16, 42, 51, 0.09);
  border-radius: 22px;
  background:
    radial-gradient(circle at 85% 13%, color-mix(in srgb, var(--ef-accent) 17%, transparent), transparent 38%),
    #ffffff;
  box-shadow: 0 18px 40px rgba(16, 42, 51, 0.08);
  overflow: hidden;
}
.ef-band-very-low { --ef-accent: #B42318; }
.ef-band-low { --ef-accent: #C96716; }
.ef-band-moderate { --ef-accent: #B58105; }
.ef-band-high { --ef-accent: #1D4E9E; }
.ef-band-very-high { --ef-accent: #0B6E4F; }
.ef-band-unclassified { --ef-accent: #64748B; }
.ef-score-eyebrow {
  color: #627780;
  font-size: 0.78rem;
  font-weight: 800;
  letter-spacing: 0.09em;
  text-transform: uppercase;
}
.ef-score-line { display: flex; align-items: baseline; gap: 0.45rem; margin-top: 14px; }
.ef-score-main {
  color: var(--ef-accent);
  font-size: clamp(4.4rem, 8vw, 7rem);
  font-weight: 850;
  letter-spacing: -0.075em;
  line-height: 0.92;
}
.ef-score-denominator { color: #78909A; font-size: 1.22rem; font-weight: 750; }
.ef-score-band { color: var(--ef-accent); font-size: 1.2rem; font-weight: 800; margin-top: 18px; }
.ef-score-decision {
  display: inline-flex;
  align-items: center;
  gap: 0.42rem;
  margin-top: 10px;
  padding: 0.43rem 0.72rem;
  border-radius: 999px;
  color: var(--ef-accent);
  background: color-mix(in srgb, var(--ef-accent) 10%, #ffffff);
  border: 1px solid color-mix(in srgb, var(--ef-accent) 22%, #ffffff);
  font-size: 0.84rem;
  font-weight: 800;
}
.ef-readiness-scale { margin-top: 26px; }
.ef-readiness-track {
  position: relative;
  height: 13px;
  border-radius: 999px;
  background: linear-gradient(
    90deg,
    #F6D6D2 0 40%, #F8E4D1 40% 60%, #F8EFC8 60% 80%, #CEE9EA 80% 90%, #CFE7D9 90% 100%
  );
  overflow: visible;
}
.ef-readiness-fill {
  width: var(--ef-score-width);
  min-width: 4px;
  max-width: 100%;
  height: 100%;
  border-radius: 999px;
  background: var(--ef-accent);
  box-shadow: 0 3px 10px color-mix(in srgb, var(--ef-accent) 28%, transparent);
}
.ef-threshold-marker {
  position: absolute;
  left: var(--ef-threshold-position);
  top: -7px;
  width: 2px;
  height: 27px;
  background: #102A33;
  border-radius: 2px;
}
.ef-threshold-labels {
  display: flex;
  justify-content: space-between;
  color: #78909A;
  font-size: 0.72rem;
  font-weight: 650;
  margin-top: 10px;
}
.ef-threshold-caption { color: #526A73; font-size: 0.8rem; margin-top: 8px; }

/* --- Summary metric cards --- */
.ef-summary-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; height: 100%; }
.ef-summary-card {
  padding: 19px;
  border: 1px solid rgba(16, 42, 51, 0.085);
  border-radius: 17px;
  background: #ffffff;
  box-shadow: 0 10px 26px rgba(16, 42, 51, 0.055);
}
.ef-summary-card-wide { grid-column: 1 / -1; }
.ef-summary-label { color: #6B818A; font-size: 0.76rem; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; }
.ef-summary-value { color: #102A33; font-size: 1.14rem; font-weight: 820; line-height: 1.28; margin-top: 9px; }
.ef-summary-note { color: #6A7F87; font-size: 0.84rem; line-height: 1.5; margin-top: 7px; }

/* --- Panel headings shared by why/action panels --- */
.ef-why-panel, .ef-action-panel { margin-top: 18px; }
.ef-panel-heading { display: flex; align-items: flex-start; gap: 0.75rem; }
.ef-panel-heading-copy h4 { margin: 0; font-size: 1.15rem; }
.ef-panel-heading-copy p { color: #56707A; margin: 0.4rem 0 0; font-size: 0.92rem; line-height: 1.5; }
.ef-svg-icon { width: 20px; height: 20px; flex: 0 0 20px; }
.ef-heading-icon { width: 26px; height: 26px; color: #1D4E9E; margin-top: 1px; flex: 0 0 26px; }

/* --- Extended explainability panel --- */
.ef-why-panel-extended {
  padding: 30px 28px;
}

/* --- Evidence meter cards (abstracted probabilities) --- */
.ef-evidence-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16px;
  margin-top: 22px;
}
.ef-evidence-grid-three { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.ef-evidence-card {
  padding: 20px 18px;
  border-radius: 16px;
  background: #F6FAFB;
  border: 1px solid #E1ECEF;
}
.ef-evidence-label {
  color: #5D747D;
  font-size: 0.78rem;
  font-weight: 800;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}
.ef-evidence-value {
  color: #102A33;
  font-size: 1.28rem;
  font-weight: 820;
  margin-top: 10px;
  line-height: 1.25;
}
.ef-evidence-value.ef-meter-ready { color: #0B6E4F; }
.ef-evidence-value.ef-meter-mixed { color: #9A6100; }
.ef-evidence-value.ef-meter-not-ready { color: #A51D15; }
.ef-evidence-value.ef-meter-neutral { color: #506771; }
.ef-evidence-note { color: #6E828A; font-size: 0.82rem; line-height: 1.5; margin-top: 10px; }

/* Meter bar: shows lean/strength without a literal % */
.ef-meter-track {
  position: relative;
  margin-top: 14px;
  height: 12px;
  border-radius: 999px;
  background: linear-gradient(90deg, #DCEFE9 0%, #FBF0D3 50%, #FADAD6 100%);
  overflow: visible;
}
.ef-meter-fill {
  height: 100%;
  border-radius: 999px;
  background: #94A3AB;
  transition: width 0.25s ease;
}
.ef-meter-fill.ef-meter-ready { background: #0B6E4F; }
.ef-meter-fill.ef-meter-mixed { background: #B58105; }
.ef-meter-fill.ef-meter-not-ready { background: #B42318; }
.ef-meter-fill.ef-meter-neutral { background: #94A3AB; }
.ef-meter-midline {
  position: absolute;
  left: 50%;
  top: -3px;
  width: 2px;
  height: 18px;
  background: rgba(16, 42, 51, 0.28);
  border-radius: 2px;
}
.ef-meter-scale-labels {
  display: flex;
  justify-content: space-between;
  color: #8A9CA4;
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.03em;
  text-transform: uppercase;
  margin-top: 7px;
}

.ef-method-note { color: #758891; font-size: 0.8rem; line-height: 1.5; margin-top: 7px; }

/* --- What supports / what to double-check --- */
.ef-explanation-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
  margin-top: 24px;
}
.ef-explanation-card { border: 1px solid #E2EBEE; border-radius: 16px; padding: 20px; background: #ffffff; }
.ef-explanation-card h5 { color: #1D3C46; font-size: 1rem; font-weight: 820; margin: 0 0 12px; }
.ef-icon-list { display: grid; gap: 12px; margin: 0; padding: 0; list-style: none; }
.ef-icon-list li { display: flex; align-items: flex-start; gap: 0.7rem; color: #3C555E; font-size: 0.9rem; line-height: 1.5; }
.ef-icon-list .ef-svg-icon { color: #1D4E9E; margin-top: 2px; }
.ef-icon-list.ef-concern-list .ef-svg-icon { color: #B45309; }

/* --- Which factors moved the score (attribution) --- */
.ef-attribution-section { margin-top: 26px; }
.ef-attribution-heading {
  color: #15304F;
  font-size: 1rem;
  font-weight: 820;
  margin-bottom: 14px;
}
.ef-attribution-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
}
.ef-attribution-card { padding: 20px; border: 1px solid #E0EAED; border-radius: 16px; background: #FBFDFD; }
.ef-attribution-card h5 { margin: 0; color: #15304F; font-size: 0.95rem; font-weight: 820; }
.ef-attribution-subtitle { color: #71858D; font-size: 0.8rem; line-height: 1.5; margin: 8px 0 16px; }
.ef-contribution-row { margin-top: 14px; }
.ef-contribution-topline { display: flex; justify-content: space-between; gap: 0.75rem; color: #3B545D; font-size: 0.84rem; }
.ef-contribution-feature { font-weight: 720; }
.ef-contribution-direction { color: #6F828A; white-space: nowrap; font-size: 0.78rem; }
.ef-contribution-track { height: 8px; margin-top: 6px; overflow: hidden; border-radius: 999px; background: #E7EEF0; }
.ef-contribution-fill { height: 100%; border-radius: 999px; background: #1D4E9E; }
.ef-contribution-fill.ef-toward-not-ready { background: #B45309; }

/* --- Recommended action panel --- */
.ef-action-layout { display: flex; align-items: flex-start; gap: 16px; }
.ef-action-icon-wrap {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  flex: 0 0 44px;
  border-radius: 14px;
  color: #1D4E9E;
  background: #E9F0FB;
}
.ef-action-title { color: #102A33; font-size: 1.12rem; font-weight: 820; }
.ef-action-context { color: #56707A; font-size: 0.86rem; line-height: 1.55; margin-top: 6px; }
.ef-next-step-list { margin: 15px 0 0; padding-left: 1.2rem; color: #3C555E; font-size: 0.88rem; line-height: 1.6; }

@media (max-width: 1100px) {
  .ef-overview-layout { grid-template-columns: 1fr; }
  .ef-evidence-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@media (max-width: 700px) {
  .ef-navbar-brand-subtitle { display: none; }
  .ef-navbar-brand { min-width: auto; }
  .ef-summary-grid,
  .ef-explanation-grid,
  .ef-attribution-grid,
  .ef-evidence-grid { grid-template-columns: 1fr; }
  .ef-score-card { min-height: 300px; }
  .ef-score-main { font-size: 4.5rem; }
}

/* ============================================================
   EXTRACTED FEATURES — PER-DOMAIN TABLE BLOCKS
   ============================================================ */
.ef-domain-feature-block {
  margin-top: 26px;
}
.ef-domain-feature-block:first-child {
  margin-top: 6px;
}
.ef-domain-feature-heading {
  margin: 0 0 12px;
  padding-bottom: 10px;
  border-bottom: 2px solid #DCEAEC;
  color: #12343E;
  font-size: 1.05rem;
  font-weight: 820;
}
.ef-domain-feature-block table.dataTable td,
.ef-domain-feature-block table.dataTable th {
  text-align: left !important;
}

/* ============================================================
   NAVBAR (name-only brand, no logo)
   ============================================================ */
.ef-navbar-brand-name-only {
  color: #173943;
  font-size: 1.08rem;
  font-weight: 800;
  letter-spacing: -0.025em;
  line-height: 1;
  white-space: nowrap;
}

/* ============================================================
   OVERVIEW TAB — fact cards beside the score hero
   ============================================================ */
.ef-interpretation-panel {
  margin-top: 20px;
}
.ef-overview-facts {
  display: grid;
  grid-template-columns: 1fr;
  gap: 14px;
  height: 100%;
}
.ef-overview-fact {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 130px;
  padding: 22px;
  border: 1px solid rgba(16, 42, 51, 0.09);
  border-radius: 16px;
  background: #ffffff;
  box-shadow: 0 10px 26px rgba(16, 42, 51, 0.06);
}
.ef-overview-fact-label {
  color: #526A72;
  font-size: 0.78rem;
  font-weight: 800;
  letter-spacing: 0.045em;
  text-transform: uppercase;
}
.ef-overview-fact-value {
  margin-top: 8px;
  color: #15304F;
  font-size: 1.3rem;
  font-weight: 850;
  line-height: 1.3;
}
.ef-overview-fact-note {
  margin-top: 8px;
  color: #56707A;
  font-size: 0.9rem;
  line-height: 1.5;
}

/* ============================================================
   SCREENING RATIONALE PANEL (Recommended Action tab)
   ============================================================ */
.ef-plain-summary {
  margin-top: 20px;
  padding: 21px 23px;
  border: 1px solid #D5E7EA;
  border-left: 5px solid #1D4E9E;
  border-radius: 16px;
  background: #F3FAFB;
  color: #244A54;
  font-size: 1rem;
  line-height: 1.72;
}
.ef-profile-split {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20px;
  align-items: start;
  margin-top: 22px;
}
.ef-profile-column {
  min-width: 0;
  padding: 24px;
  border: 1px solid #DCE7E9;
  border-radius: 17px;
  background: #ffffff;
}
.ef-profile-column-positive {
  border-top: 4px solid #138A63;
  background: linear-gradient(180deg, #F7FCF9 0%, #FFFFFF 28%);
}
.ef-profile-column-negative {
  border-top: 4px solid #B45309;
  background: linear-gradient(180deg, #FFF9F3 0%, #FFFFFF 28%);
}
.ef-profile-column-heading {
  padding-bottom: 12px;
  border-bottom: 1px solid #E2EBED;
}
.ef-profile-column-heading h5 {
  margin: 0;
  color: #183C45;
  font-size: 1.05rem;
  font-weight: 820;
}
.ef-profile-column-rows {
  display: grid;
  gap: 13px;
  margin-top: 16px;
}
.ef-profile-row {
  padding: 16px 17px;
  border: 1px solid #E2EBED;
  border-left: 4px solid #94A3AB;
  border-radius: 13px;
  background: #FAFCFC;
}
.ef-profile-row.profile-good { border-left-color: #138A63; }
.ef-profile-row.profile-warn { border-left-color: #C98512; }
.ef-profile-row.profile-danger { border-left-color: #B42318; }
.ef-profile-row.profile-neutral { border-left-color: #94A3AB; }
.ef-profile-row-main {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
}
.ef-profile-row-title {
  color: #173B44;
  font-size: 0.96rem;
  font-weight: 800;
}
.ef-profile-status {
  flex: 0 0 auto;
  padding: 0.32rem 0.58rem;
  border-radius: 999px;
  background: #EEF3F5;
  color: #506771;
  font-size: 0.74rem;
  font-weight: 800;
  white-space: nowrap;
}
.profile-good .ef-profile-status { background: #E4F4ED; color: #0B6E4F; }
.profile-warn .ef-profile-status { background: #FFF2D9; color: #8B5900; }
.profile-danger .ef-profile-status { background: #FCE9E7; color: #A51D15; }
.ef-profile-row-text {
  margin-top: 9px;
  color: #465F68;
  font-size: 0.9rem;
