  border-radius: 9px;

  box-shadow:
    0 12px 30px rgba(18, 39, 92, 0.16);
}


/* ==========================================================
   CANCELLATION OVERLAY INTERACTION
   ========================================================== */

#epiforess_loading_overlay {
  pointer-events: auto;
}

#epiforess_loading_overlay
.btn-cancel-scoring {
  position: relative;
  z-index: 2000;

  pointer-events: auto;

  transition:
    background-color 0.15s ease,
    transform 0.15s ease,
    box-shadow 0.15s ease;
}

#epiforess_loading_overlay
.btn-cancel-scoring:hover {
  background: #922019 !important;
  transform: translateY(-1px);

  box-shadow:
    0 4px 10px rgba(179, 38, 30, 0.28) !important;
}

#epiforess_loading_overlay
.btn-cancel-scoring:active {
  transform: translateY(0);
}


/* ==========================================================
   MOBILE LAYOUT
   ========================================================== */

@media (max-width: 900px) {

  .ef-global-series-switcher {
    position: relative;
    top: auto;

    grid-template-columns: 1fr;
    gap: 13px;

    padding: 15px 16px;
  }
}

@media (max-width: 560px) {

  .ef-global-series-switcher {
    margin-bottom: 13px;
    border-radius: 11px;
  }

  .ef-global-series-switcher-copy p {
    font-size: 0.78rem;
  }

  .ef-global-series-switcher-control
  .selectize-input {
    min-height: 44px;
    font-size: 0.82rem;
  }
}


/* ==========================================================
   ESTIMATED MEDIAN BEST MASE
   ========================================================== */

.ef-secondary-mase-estimate {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  gap: 4px 18px;

  margin-top: 17px;
  padding: 13px 15px;

  background: rgba(255, 255, 255, 0.74);
  border: 1px solid rgba(29, 78, 158, 0.16);
  border-radius: 10px;
}

.ef-secondary-mase-copy {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.ef-secondary-mase-label {
  color: var(--ep-primary-dark, #143A6B);
  font-size: 0.84rem;
  font-weight: 720;
}

.ef-secondary-mase-note {
  margin-top: 2px;

  color: #6a7c85;
  font-size: 0.72rem;
  font-weight: 500;
}

.ef-secondary-mase-value {
  color: #17365d;
  font-size: 1.48rem;
  font-weight: 760;
  line-height: 1;
  text-align: right;
}

.ef-secondary-mase-footnote {
  grid-column: 1 / -1;

  margin-top: 3px;

  color: #647781;
  font-size: 0.72rem;
  line-height: 1.4;
}

@media (max-width: 560px) {

  .ef-secondary-mase-estimate {
    grid-template-columns: 1fr auto;
    gap: 5px 12px;
  }

  .ef-secondary-mase-value {
    font-size: 1.28rem;
  }
}
